menuconfig SENSOR_KEY
	bool "SENSOR_KEY GPIO key sensor"
	depends on GPIO
	help
	  Enable driver for SENSOR_KEY GPIO key sensors.

if SENSOR_KEY

choice
	prompt "Trigger mode"
	default SENSOR_KEY_TRIGGER_NONE
	help
	  Specify the type of triggering to be used by the driver.

config SENSOR_KEY_TRIGGER_NONE
	bool "No trigger"

config SENSOR_KEY_TRIGGER_GLOBAL_THREAD
	bool "Use global thread"
	depends on GPIO
	select SENSOR_KEY_TRIGGER

config SENSOR_KEY_TRIGGER_OWN_THREAD
	bool "Use own thread"
	depends on GPIO
	select SENSOR_KEY_TRIGGER

endchoice

config SENSOR_KEY_TRIGGER
	bool

config SENSOR_KEY_THREAD_PRIORITY
	int "Thread priority"
	depends on SENSOR_KEY_TRIGGER_OWN_THREAD
	default 10
	help
	  Priority of thread used by the driver to handle interrupts.

config SENSOR_KEY_THREAD_STACK_SIZE
	int "Thread stack size"
	depends on SENSOR_KEY_TRIGGER_OWN_THREAD
	default 256
	help
	  Stack size of thread used by the driver to handle interrupts.

endif # SENSOR_KEY
